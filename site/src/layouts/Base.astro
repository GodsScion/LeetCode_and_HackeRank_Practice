---
import '../styles/global.css';
import { href, REPO_URL, OWNER } from '../components/site.ts';
import CodeThemePicker from '../components/CodeThemePicker.astro';
import { CODE_THEMES, CODE_THEME_STORAGE_KEY } from '../components/codeThemes.ts';

interface Props {
  title: string;
  description?: string;
  /** Wide pages (the problem list, a detail page) vs. centred reading pages. */
  bodyClass?: string;
}

const {
  title,
  description = 'LeetCode and HackerRank solutions, worked approaches and interview notes by Sai Vignesh Golla.',
  bodyClass,
} = Astro.props;

const nav = [
  { label: 'Problems', path: '/' },
  { label: 'Notes', path: '/notes/' },
  { label: 'Scratch', path: '/scratch/' },
  { label: 'Add', path: '/add/' },
];

const here = Astro.url.pathname.replace(/\/+$/, '/') || '/';
const isCurrent = (path: string) => {
  const target = href(path);
  if (path === '/') return here === target || here === target.replace(/\/$/, '');
  return here.startsWith(target) || here.startsWith(target.replace(/\/$/, ''));
};

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const fullTitle = title === 'Problems' ? `Syntax Shenanigans — ${OWNER}` : `${title} · Syntax Shenanigans`;

const codeThemeKeys = CODE_THEMES.map((t) => t.key);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={OWNER} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#050505" />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="generator" content={Astro.generator} />

    {/*
      Apply the stored code theme before the first paint. Parser-blocking and
      inline by design: deferring it, or bundling it, would show one frame of
      Dark Modern to a reader who chose Monokai. Unknown values are ignored, so
      a stale or hand-edited key falls back to the default the CSS already
      renders. `data-code-theme` is the only thing this touches.
    */}
    <script is:inline define:vars={{ storageKey: CODE_THEME_STORAGE_KEY, keys: codeThemeKeys }}>
      try {
        var stored = localStorage.getItem(storageKey);
        if (stored && keys.indexOf(stored) !== -1) {
          document.documentElement.setAttribute('data-code-theme', stored);
        }
      } catch (e) {
        /* storage blocked — the default theme is already correct */
      }
    </script>
  </head>

  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>

    <header
      class="sticky top-0 z-50 border-b border-line bg-bg/72 backdrop-blur-glass supports-[backdrop-filter]:bg-bg/72"
    >
      {/* gap and logo padding tighten below sm so the theme picker fits at
          390px without pushing "Add" into the nav's overflow scroller */}
      <div class="shell flex h-14 items-center gap-2 sm:gap-3">
        <a
          href={href('/')}
          class="group flex shrink-0 items-center gap-2.5 rounded-chip px-0.5 py-1 sm:px-1"
          aria-label={`${OWNER} — home`}
        >
          <span
            class="grid h-6 w-6 place-items-center rounded-md border border-line bg-surface font-mono text-[0.6875rem] leading-none text-fg-muted transition-colors group-hover:text-fg"
            aria-hidden="true">S</span
          >
          <span class="hidden font-mono text-xs tracking-[0.18em] uppercase sm:inline">savign</span>
          <span class="hidden text-xs text-fg-faint md:inline" aria-hidden="true">/</span>
          <span class="hidden text-xs text-fg-subtle md:inline">Syntax Shenanigans</span>
        </a>

        <nav
          class="-mx-1 flex min-w-0 flex-1 items-center gap-0.5 overflow-x-auto px-1 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
          aria-label="Primary"
        >
          {
            nav.map((item) => (
              <a
                class="nav-link"
                href={href(item.path)}
                aria-current={isCurrent(item.path) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>

        <CodeThemePicker />

        <a
          class="nav-link shrink-0"
          href={REPO_URL}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Repository on GitHub"
        >
          <svg
            width="15"
            height="15"
            viewBox="0 0 16 16"
            fill="currentColor"
            aria-hidden="true"
            focusable="false"
          >
            <path
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
            ></path>
          </svg>
        </a>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="mt-section border-t border-line">
      <div
        class="shell flex flex-col gap-3 py-8 text-xs text-fg-subtle sm:flex-row sm:items-center sm:justify-between"
      >
        <p>
          <span class="text-fg-muted">{OWNER}</span> · a running record of interview
          practice, kept honest.
        </p>
        <p class="flex flex-wrap items-center gap-x-4 gap-y-1">
          <a class="link-underline hover:text-fg" href="https://savign.org">savign.org</a>
          <a
            class="link-underline hover:text-fg"
            href={REPO_URL}
            target="_blank"
            rel="noopener noreferrer">Source</a
          >
          <a class="link-underline hover:text-fg" href={href('/add/')}>Add a problem</a>
        </p>
      </div>
    </footer>

    <script>
      // Copy-to-clipboard, delegated once for every code block on the page.
      // The exact source text is read back out of the Shiki markup, so nothing
      // is duplicated into the HTML payload.
      const RESET_MS = 1600;
      const timers = new WeakMap<HTMLElement, number>();

      document.addEventListener('click', (event) => {
        const target = event.target as Element | null;
        const button = target?.closest<HTMLButtonElement>('button[data-copy]');
        if (!button) return;

        const pre = button.parentElement?.querySelector('pre');
        const text = pre?.textContent;
        if (!text) return;

        const done = (ok: boolean) => {
          button.textContent = ok ? 'Copied' : 'Failed';
          button.dataset.copied = String(ok);
          const previous = timers.get(button);
          if (previous) window.clearTimeout(previous);
          timers.set(
            button,
            window.setTimeout(() => {
              button.textContent = 'Copy';
              delete button.dataset.copied;
            }, RESET_MS),
          );
        };

        navigator.clipboard?.writeText(text).then(
          () => done(true),
          () => done(false),
        );
      });
    </script>
  </body>
</html>
