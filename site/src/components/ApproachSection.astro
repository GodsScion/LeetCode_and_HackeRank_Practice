---
import type { Approach } from '../lib/types.ts';
import { proseToHtml } from './prose.ts';
import Prose from './Prose.astro';
import LangTabs from './LangTabs.astro';
import PitfallsCallout from './PitfallsCallout.astro';

interface Props {
  approach: Approach;
  /** 1-based position within the problem. */
  index: number;
  problemSlug: string;
}

const { approach, index, problemSlug } = Astro.props;

// "Solution 1 — Sorted Key" when the author tagged it, plain "Solution 1" when
// the name was auto-generated.
const heading = `Solution ${index}`;
const subtitle = approach.named ? approach.name : undefined;
const anchor = `solution-${index}`;
const banned = proseToHtml(approach.doNotUseInInterview);

// More than one attempt has something of its own to say, so the notes belong in
// the tabs where they can be compared, not merged into one block above them.
// Below that threshold nothing moves, which is every problem logged before
// repeat attempts existed.
const withNotes = approach.implementations.filter(
  (impl) => impl.explanation?.trim() || impl.pitfalls?.trim(),
);
const showAttemptNotes = withNotes.length > 1;
const complexity = [
  { label: 'Time', value: approach.timeComplexity },
  { label: 'Space', value: approach.spaceComplexity },
].filter((c) => c.value);
---

<section class="scroll-mt-28" id={anchor} aria-labelledby={`${anchor}-h`}>
  <header class="flex flex-wrap items-center gap-x-3 gap-y-2">
    <h2 id={`${anchor}-h`} class="text-xl min-w-0">
      <span>{heading}</span>
      {
        subtitle && (
          <>
            <span class="text-fg-faint font-normal mx-1.5" aria-hidden="true">
              —
            </span>
            <span class="text-fg-muted font-normal">{subtitle}</span>
          </>
        )
      }
    </h2>
    {
      banned && (
        <span class="chip chip-danger" title="This solution would not be accepted in an interview">
          Do not use in an interview
        </span>
      )
    }
    {
      complexity.length > 0 && (
        <ul class="flex flex-wrap items-center gap-1.5 list-none">
          {complexity.map((c) => (
            <li class="chip">
              <span class="text-fg-faint">{c.label}</span>
              <span class="mx-1 text-fg-faint" aria-hidden="true">
                ·
              </span>
              <span class="text-fg">{c.value}</span>
            </li>
          ))}
        </ul>
      )
    }
  </header>

  {
    banned && (
      <div class="callout callout-danger mt-4" role="note">
        <svg
          class="callout-icon"
          width="16"
          height="16"
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          aria-hidden="true"
          focusable="false"
        >
          <circle cx="8" cy="8" r="6.5" />
          <path d="M4.5 4.5 11.5 11.5" />
        </svg>
        <p class="callout-title">Do not use in an interview</p>
        <div class="prose" set:html={banned} />
      </div>
    )
  }

  {!showAttemptNotes && <Prose text={approach.explanation} class="mt-3 max-w-[68ch]" />}

  {!showAttemptNotes && <PitfallsCallout text={approach.pitfalls} class="mt-4" />}

  <div class="mt-4">
    <LangTabs
      implementations={approach.implementations}
      group={`${problemSlug}--${approach.id}`}
      showAttemptNotes={showAttemptNotes}
    />
  </div>
</section>
