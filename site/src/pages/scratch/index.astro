---
import Base from '../../layouts/Base.astro';
import ExternalIcon from '../../components/ExternalIcon.astro';
import { href, githubDevTreeUrl, LANG_LABEL } from '../../components/site.ts';
import { parseAll } from '../../lib/parser.ts';

const { scratch } = parseAll();
---

<Base
  title="Scratch pad"
  description="Working files from the scratch pad — half-finished attempts and throwaway experiments, kept read-only."
>
  <div class="shell pt-stack pb-stack">
    <header class="max-w-[56ch]">
      <p class="eyebrow">Scratch pad</p>
      <h1 class="mt-3 text-4xl">Work in progress, on purpose.</h1>
      <p class="prose mt-5">
        Whatever happened to be open when the timer ran out. Half-finished attempts,
        throwaway experiments, code that does not run. Nothing here has been reviewed
        and nothing here is a reference — for that, go to the
        <a class="link-underline" href={href('/')}>problems</a>.
      </p>
    </header>

    {
      scratch.length === 0 ? (
        <p class="mt-10 text-sm text-fg-subtle">The scratch pad is empty.</p>
      ) : (
        <ul class="mt-stack grid gap-3 sm:grid-cols-2">
          {scratch.map((file) => (
            <li class="glass group relative flex flex-col gap-4 p-5 transition-colors hover:bg-surface-2">
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                  <h2 class="text-lg">
                    <a
                      class="after:absolute after:inset-0 after:content-['']"
                      href={href(`/scratch/${file.slug}/`)}
                    >
                      <span class="font-mono">{file.name}</span>
                    </a>
                  </h2>
                  <p class="meta mt-1 truncate font-mono" title={file.path}>
                    {file.path}
                  </p>
                </div>
                <span class="chip shrink-0">{LANG_LABEL[file.lang] ?? file.lang}</span>
              </div>
              <p class="meta tnum mt-auto">
                {file.lineCount} {file.lineCount === 1 ? 'line' : 'lines'}
              </p>
            </li>
          ))}
        </ul>
      )
    }

    <p class="mt-stack max-w-[60ch] text-sm text-fg-subtle">
      Every file is rendered read-only. To change one, open it in
      <a
        class="link-underline inline-flex items-center gap-1 whitespace-nowrap hover:text-fg"
        href={githubDevTreeUrl('scratch pad')}
        target="_blank"
        rel="noopener noreferrer">github.dev <ExternalIcon /></a
      >.
    </p>
  </div>
</Base>
